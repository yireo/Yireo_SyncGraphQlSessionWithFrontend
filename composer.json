        "magento/module-quote": "^100.1|^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "yireo/magento2-integration-test-helper": "~0.0"
